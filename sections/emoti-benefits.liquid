{%- liquid
  assign title = section.settings.title
  if title == blank
    assign title = 'emoti.benefits.title' | t
  endif
-%}
<section class="benefits" aria-labelledby="benefits-heading">
  <div class="container">
    <h2 id="benefits-heading">{{ title }}</h2>
    <ul class="benefits__list">
      {%- for block in section.blocks -%}
        <li class="benefit" {{ block.shopify_attributes }}>
          <span class="benefit__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "EMOTI Benefits",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "info": "Leave blank to use the page's translated default (\"Why join the list\" / \"Perché entrare in lista\")."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "EMOTI Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Access 24 hours early", "description": "Saturday 10.10 at 20:00, list members only." } },
        { "type": "benefit", "settings": { "title": "Limited pieces", "description": "One production run. No restock." } },
        { "type": "benefit", "settings": { "title": "Bring 3 friends", "description": "Get into the first early-access group." } }
      ]
    }
  ]
}
{% endschema %}
