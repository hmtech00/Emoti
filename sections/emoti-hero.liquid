{%- comment -%}
  Hero + Drop Promise + Countdown + Sign-up form, as ONE section.

  Why one file instead of the three separate sections suggested in the
  brief (emoti-hero / emoti-countdown / emoti-waitlist): the desktop
  layout needs the campaign image and the promise+countdown+form to sit
  in a true CSS Grid two-column composition (image ~60%, copy+form ~40%,
  above the fold — see #38 in the brief). That only works reliably when
  they're real DOM siblings inside one grid container. Independent
  sections can be freely reordered or split apart in the Theme Editor,
  which would silently break that layout. Keeping them as one section
  with four blocks (media / promise / countdown / form) gets the same
  editability the brief asks for — merchants still edit each piece's
  text independently — without that fragility. See README "Design
  decisions".
{%- endcomment -%}
{%- liquid
  assign headline_line1 = section.settings.headline_line1
  if headline_line1 == blank
    assign headline_line1 = 'emoti.hero.headline_line1' | t
  endif
  assign headline_line2 = section.settings.headline_line2
  if headline_line2 == blank
    assign headline_line2 = 'emoti.hero.headline_line2' | t
  endif
  assign subtext = section.settings.subtext
  if subtext == blank
    assign subtext = 'emoti.hero.subtext' | t
  endif
  assign form_title = section.settings.form_title
  if form_title == blank
    assign form_title = 'emoti.form.title' | t
  endif

  assign public_date = settings.public_drop_datetime | date: '%d.%m'
  assign public_time = settings.public_drop_datetime | date: '%H:%M'
  assign early_date = settings.early_access_datetime | date: '%d.%m'
  assign early_time = settings.early_access_datetime | date: '%H:%M'
-%}

<div class="hero-composition" id="emoti-hero-composition">

  <div class="hero-media" data-component="hero-media">
    {%- if section.settings.hero_video != blank -%}
      {{
        section.settings.hero_video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          image_size: '1200x'
      }}
    {%- elsif section.settings.hero_image != blank -%}
      {{
        section.settings.hero_image
        | image_url: width: 1600
        | image_tag:
          loading: 'eager',
          widths: '800,1200,1600',
          sizes: '(min-width: 960px) 60vw, 100vw',
          alt: section.settings.hero_image_alt | default: shop.name,
          class: 'hero-media__image'
      }}
    {%- else -%}
      <div class="hero-media__placeholder">
        <span>{{ 'emoti.hero.media_placeholder' | t }}</span>
      </div>
    {%- endif -%}
  </div>

  <section class="promise" aria-labelledby="promise-heading">
    <p class="eyebrow">{{ 'emoti.hero.eyebrow' | t: public_date: public_date, public_time: public_time }}</p>
    <h1 id="promise-heading" class="promise__heading">
      <span>{{ headline_line1 }}</span><br>
      <span>{{ headline_line2 }}</span>
    </h1>
    <p class="promise__sub">{{ subtext }}</p>

    {%- render 'emoti-countdown-markup' -%}
  </section>

  <section class="signup" id="signup" aria-labelledby="signup-heading">
    <div class="signup-card">
      <h2 id="signup-heading">{{ form_title }}</h2>
      <p class="signup-card__sub">
        {{- 'emoti.form.subtitle' | t: early_date: early_date, early_time: early_time -}}
      </p>

      {%- comment -%}
        Real Shopify customer sign-up (the same mechanism Dawn's
        newsletter section uses: {% form 'customer' %} with
        contact[email]). This genuinely creates/updates a Customer in
        Shopify Admin — nothing here is mocked.

        Country / size / WhatsApp number aren't native customer fields,
        so they're written into contact[note] (always) and folded into
        contact[tags] (assets/emoti-form.js composes both right before
        submit, based on what the visitor filled in and consented to).
        For structured, queryable fields instead of note text, define
        Customer metafields under Settings → Custom data → Customers,
        then switch the hidden inputs below to
        contact[metafields][custom][your_key] — see README.

        VERIFY THIS FORM in a Shopify dev store before launch: Liquid's
        exact accepted field set for the customer/contact form isn't
        something this environment could execute to confirm.
      {%- endcomment -%}
      {%- liquid
        assign return_to = '/pages/thank-you'
        if settings.thank_you_page != blank
          assign return_to = settings.thank_you_page.url
        endif
      -%}
      {%- comment -%}
        Only `id` and `return_to` are passed here — Shopify's form tag
        doesn't accept arbitrary HTML attributes (a class/data-* param
        would not render on the generated <form>). The form is targeted
        by its id (#EmotiWaitlistForm) from assets/emoti-form.js, and its
        fields are styled via .field/.consent-group/.btn-primary in
        assets/emoti.css regardless of the form element's own class.
      {%- endcomment -%}
      {%- form 'customer', id: 'EmotiWaitlistForm', return_to: return_to -%}
        <input type="hidden" name="contact[tags]" id="ContactTags" value="drop01-waitlist">
        <input type="hidden" name="contact[note]" id="ContactNote" value="">

        <div class="field">
          <label for="Email">{{ 'emoti.form.email_label' | t }}</label>
          <input
            type="email"
            id="Email"
            name="contact[email]"
            autocomplete="email"
            required
            placeholder="{{ 'emoti.form.email_placeholder' | t }}"
          >
          <span class="field__error" id="email-error"></span>
        </div>

        <div class="field">
          <label for="Country">{{ 'emoti.form.country_label' | t }}</label>
          <select id="Country" name="country" required>
            <option value="">{{ 'emoti.form.country_placeholder' | t }}</option>
            {%- for country in localization.available_countries -%}
              <option value="{{ country.name }}">{{ country.name }}</option>
            {%- else -%}
              {%- comment -%} Fallback list if Shopify Markets countries aren't configured yet. {%- endcomment -%}
              {%- assign fallback_countries = 'Italy,France,Germany,Spain,Portugal,Netherlands,Belgium,Austria,Switzerland,Ireland,Sweden,Denmark,Finland,Poland,Greece,United Kingdom,United States,Canada,Other' | split: ',' -%}
              {%- for c in fallback_countries -%}
                <option value="{{ c }}">{{ c }}</option>
              {%- endfor -%}
            {%- endfor -%}
          </select>
          <span class="field__error" id="country-error"></span>
        </div>

        <div class="field">
          <label>
            <span>{{ 'emoti.form.size_label' | t }}</span>
            <span class="optional-tag">{{ 'emoti.form.size_optional' | t }}</span>
          </label>
          <div class="size-options" role="group" aria-label="{{ 'emoti.form.size_label' | t }}">
            {%- assign sizes = 'XS,S,M,L,XL' | split: ',' -%}
            {%- for size in sizes -%}
              <input type="radio" id="size-{{ size | handleize }}" name="size" value="{{ size }}">
              <label for="size-{{ size | handleize }}">{{ size }}</label>
            {%- endfor -%}
          </div>
        </div>

        <div class="field">
          <label for="Whatsapp">
            <span>{{ 'emoti.form.whatsapp_label' | t }}</span>
            <span class="optional-tag">{{ 'emoti.form.whatsapp_optional' | t }}</span>
          </label>
          <input type="tel" id="Whatsapp" name="whatsapp" autocomplete="tel" placeholder="{{ 'emoti.form.whatsapp_placeholder' | t }}">
        </div>

        <div class="consent-group">
          <div class="consent-row">
            <input type="checkbox" id="consent-email" name="consent-email">
            <label for="consent-email">{{ 'emoti.form.consent_email' | t }}</label>
          </div>
          <div class="consent-row">
            <input type="checkbox" id="consent-whatsapp" name="consent-whatsapp">
            <label for="consent-whatsapp">{{ 'emoti.form.consent_whatsapp' | t }}</label>
          </div>
        </div>

        <p class="form-summary" data-form-summary role="alert" hidden></p>

        <button type="submit" class="btn-primary">{{ 'emoti.form.submit_cta' | t }}</button>

        <p class="privacy-note">
          <span>{{ 'emoti.form.privacy_note' | t }}</span>
          {%- if settings.privacy_url != blank -%}
            <a href="{{ settings.privacy_url }}">{{ 'emoti.form.privacy_link' | t }}</a>
          {%- endif -%}
        </p>
      {%- endform -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "EMOTI Hero + Sign-up",
  "settings": [
    {
      "type": "header",
      "content": "Campaign media"
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Hero video",
      "info": "Shopify-hosted video. Must be the same clip used in the Instagram ad. Takes priority over the image below."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Used if no video is set, or as the video's loading frame."
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text"
    },
    {
      "type": "header",
      "content": "Copy (leave blank to use the page's translated default)"
    },
    {
      "type": "text",
      "id": "headline_line1",
      "label": "Headline — line 1"
    },
    {
      "type": "text",
      "id": "headline_line2",
      "label": "Headline — line 2"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Sign-up form title"
    }
  ]
}
{% endschema %}
