<section class="basic-page">
  <div class="container">
    <h1>{{ blog.title }}</h1>
    <ul class="basic-blog-list">
      {%- for article in blog.articles -%}
        <li>
          <a href="{{ article.url }}">{{ article.title }}</a>
          <p>{{ article.published_at | date: '%d %b %Y' }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{ "name": "Blog (baseline)", "settings": [] }
{% endschema %}
